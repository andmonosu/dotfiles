{
  "$schema": "https://opencode.ai/config.json",

  // Modelo por defecto
  "model": "local/qwen3.5-9b",

  // Proveedor local (llama.cpp)
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Llama.cpp",

      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "llama-cpp"
      },

      "models": {
        "qwen3.5-9b": {
          "name": "Qwen 3.5 9B Q6_K"
        }
      }
    }
  },

  // Muy recomendable para proyectos grandes
  "compaction": {
    "auto": true,
    "reserved": 12000
  },

  // Activa el soporte LSP
  "lsp": true,

  // Formateadores automáticos
  "formatter": true,

  // Yo dejaría permisos libres en tu máquina
  "permission": "allow"
}
